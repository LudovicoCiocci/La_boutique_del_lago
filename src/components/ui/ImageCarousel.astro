---
const { images = [], aspectRatio = '16 / 9' } = Astro.props;

function resolveImgSrc(src) {
  if (typeof src === 'object' && src !== null && src.src) {
    return src.src;
  }
  return src;
}
---

<div class="embla relative">
  <div class="embla__viewport overflow-hidden">
    <div class="embla__container flex">
      {images.map((image, index) => (
        <div class="embla__slide min-w-0 flex-[0_0_100%]">
          <div class="embla__slide__inner cursor-pointer " style={`aspect-ratio: ${aspectRatio};`}>
            <img 
              src={resolveImgSrc(image.src)} 
              alt={image.alt || ''} 
              data-caption={image.caption || ''}
              class="embla__slide__img w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
              loading="lazy"
            />
            {image.caption && (
              <p class="embla__slide__caption">{image.caption}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="embla__controls">
    <button class="embla__button embla__prev" type="button" aria-label="Previous slide">
      ‹
    </button>
    <div class="embla__dots"></div>
    <button class="embla__button embla__next" type="button" aria-label="Next slide">
      ›
    </button>
  </div>

  <!-- Shared Lightbox Dialog -->
  <dialog class="lightbox-dialog backdrop:bg-black/90 bg-transparent p-0 m-auto max-w-[95vw] max-h-[95vh] rounded-2xl outline-none">
    <div class="relative flex items-center justify-center p-4 min-h-[50vh]">
      <!-- Close Button -->
      <button class="lightbox-close absolute top-4 right-4 z-20 bg-teal-800/60 text-white hover:bg-terracotta p-2.5 rounded-full transition-all" type="button" aria-label="Close fullscreen view">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <!-- Prev Button -->
      <button class="lightbox-prev absolute left-4 z-20 bg-teal-800/60 text-white hover:bg-terracotta p-3 rounded-full transition-all hover:scale-110" type="button" aria-label="Previous image">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </button>

      <!-- Main Fullscreen Content -->
      <div class="flex flex-col items-center">
        <img class="lightbox-img object-contain max-h-[80vh] w-auto rounded-lg select-none" src="" alt="" />
        <p class="lightbox-caption text-white/80 text-sm mt-3 text-center drop-shadow-lg"></p>
      </div>

      <!-- Next Button -->
      <button class="lightbox-next absolute right-4 z-20 bg-teal-800/60 text-white hover:bg-terracotta p-3 rounded-full transition-all hover:scale-110" type="button" aria-label="Next image">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </dialog>
</div>

<script>
  import EmblaCarousel from 'embla-carousel';

  function initEmbla() {
    const carousels = document.querySelectorAll('.embla');

    carousels.forEach((carouselNode) => {
      const viewportNode = carouselNode.querySelector('.embla__viewport');
      const prevBtnNode = carouselNode.querySelector('.embla__prev');
      const nextBtnNode = carouselNode.querySelector('.embla__next');
      const dotsNode = carouselNode.querySelector('.embla__dots');

      // Lightbox elements
      const dialog = carouselNode.querySelector('.lightbox-dialog');
      const lightboxImg = carouselNode.querySelector('.lightbox-img');
      const lightboxCaption = carouselNode.querySelector('.lightbox-caption');
      const lightboxClose = carouselNode.querySelector('.lightbox-close');
      const lightboxPrev = carouselNode.querySelector('.lightbox-prev');
      const lightboxNext = carouselNode.querySelector('.lightbox-next');
      const slideImgs = carouselNode.querySelectorAll('.embla__slide__img');

      if (!viewportNode) return;

      const emblaApi = EmblaCarousel(viewportNode, { loop: true });

      // --- Lightbox Syncing ---
      const updateLightbox = () => {
        if (!dialog?.open || !lightboxImg) return;
        
        const selectedIndex = emblaApi.selectedScrollSnap();
        const activeSlideImg = slideImgs[selectedIndex];

        if (activeSlideImg) {
          lightboxImg.src = activeSlideImg.src;
          lightboxImg.alt = activeSlideImg.alt;
          if (lightboxCaption) {
            lightboxCaption.textContent = activeSlideImg.dataset.caption || '';
          }
        }
      };

      // Open Lightbox on image click
      slideImgs.forEach((img, index) => {
        img.addEventListener('click', () => {
          emblaApi.scrollTo(index);
          if (dialog) {
            dialog.showModal();
            document.body.style.overflow = 'hidden';
            updateLightbox();
          }
        });
      });

      // Update Lightbox dynamically whenever Embla slides
      emblaApi.on('select', updateLightbox);

      // Lightbox controls delegate directly to Embla
      lightboxPrev?.addEventListener('click', (e) => {
        e.stopPropagation();
        emblaApi.scrollPrev();
      });

      lightboxNext?.addEventListener('click', (e) => {
        e.stopPropagation();
        emblaApi.scrollNext();
      });

      // Close handling
      const closeLightbox = () => {
        dialog?.close();
        document.body.style.overflow = '';
      };

      lightboxClose?.addEventListener('click', closeLightbox);
      dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) closeLightbox();
      });
      dialog?.addEventListener('close', () => {
        document.body.style.overflow = '';
      });

      // Keyboard arrow support inside modal
      window.addEventListener('keydown', (e) => {
        if (!dialog?.open) return;
        if (e.key === 'ArrowLeft') emblaApi.scrollPrev();
        if (e.key === 'ArrowRight') emblaApi.scrollNext();
      });

      // --- Existing Embla Controls ---
      if (prevBtnNode) prevBtnNode.addEventListener('click', () => emblaApi.scrollPrev());
      if (nextBtnNode) nextBtnNode.addEventListener('click', () => emblaApi.scrollNext());

      if (dotsNode) {
        const slideCount = emblaApi.scrollSnapList().length;
        dotsNode.innerHTML = '';

        const dotNodes = [];
        for (let i = 0; i < slideCount; i++) {
          const dot = document.createElement('button');
          dot.className = 'embla__dot';
          dot.type = 'button';
          dot.ariaLabel = `Go to slide ${i + 1}`;
          dot.addEventListener('click', () => emblaApi.scrollTo(i));
          dotsNode.appendChild(dot);
          dotNodes.push(dot);
        }

        const updateDots = () => {
          const selectedIndex = emblaApi.selectedScrollSnap();
          dotNodes.forEach((dot, index) => {
            if (index === selectedIndex) {
              dot.classList.add('embla__dot--selected');
            } else {
              dot.classList.remove('embla__dot--selected');
            }
          });
        };

        emblaApi.on('select', updateDots);
        emblaApi.on('init', updateDots);
        updateDots();
      }
    });
  }

  initEmbla();
  document.addEventListener('astro:page-load', initEmbla);
</script>
