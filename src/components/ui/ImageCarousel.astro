---
const { images = [], aspectRatio = '16 / 9' } = Astro.props;

function resolveImgSrc(src) {
  if (typeof src === 'object' && src !== null && src.src) {
    return src.src;
  }
  return src;
}
---

<div class="embla relative">
  <div class="embla__viewport overflow-hidden">
    <div class="embla__container flex">
      {images.map((image, index) => (
        <div class="embla__slide min-w-0 flex-[0_0_100%]">
          <div class="embla__slide__inner cursor-pointer " style={`aspect-ratio: ${aspectRatio};`}>
            <img 
              src={resolveImgSrc(image.src)} 
              alt={image.alt || ''} 
              data-caption={image.caption || ''}
              class="embla__slide__img w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
              loading="lazy"
            />
            {image.caption && (
              <p class="embla__slide__caption">{image.caption}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="embla__controls">
    <button class="embla__button embla__prev" type="button" aria-label="Previous slide">
      ‹
    </button>
    <div class="embla__dots"></div>
    <button class="embla__button embla__next" type="button" aria-label="Next slide">
      ›
    </button>
  </div>

  <dialog class="lightbox-dialog fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0 outline-none backdrop:bg-black/60">
    <div class="lightbox-stage relative flex h-full w-full items-center justify-center overflow-hidden bg-black/80 p-3">
      <!-- Shrink-wraps the image, so the nav row below is exactly as wide as
           the picture and the arrows sit flush with its edges. -->
      <!-- pt-12 reserves a band above the image for the close button, leaving the
           same gap-2 clearance the arrows have below the image. -->
      <div class="lightbox-frame relative flex max-w-full flex-col items-center gap-2 pt-13">
        <img class="lightbox-img object-contain select-none" src="" alt="" draggable="false" />

        <div class="lightbox-nav flex w-full items-center justify-between gap-2">
          <button class="lightbox-prev shrink-0 bg-teal-800/60 text-white backdrop-blur-sm hover:bg-terracotta p-3 rounded-full transition-all hover:scale-110" type="button" aria-label="Immagine precedente">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>

          <p class="lightbox-caption min-w-0 flex-1 text-center text-white/80 text-sm drop-shadow-lg"></p>

          <button class="lightbox-next shrink-0 bg-teal-800/60 text-white backdrop-blur-sm hover:bg-terracotta p-3 rounded-full transition-all hover:scale-110" type="button" aria-label="Immagine successiva">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>

        <button class="lightbox-close absolute right-0 top-0 z-30 bg-teal-800/60 text-white backdrop-blur-sm hover:bg-terracotta p-2.5 rounded-full transition-all" type="button" aria-label="Chiudi la vista a schermo intero">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </dialog>
</div>

<script>
  import EmblaCarousel from 'embla-carousel';

  function initEmbla() {
    const carousels = document.querySelectorAll('.embla');

    carousels.forEach((carouselNode) => {
      const viewportNode = carouselNode.querySelector('.embla__viewport');
      const prevBtnNode = carouselNode.querySelector('.embla__prev');
      const nextBtnNode = carouselNode.querySelector('.embla__next');
      const dotsNode = carouselNode.querySelector('.embla__dots');

      const dialog = carouselNode.querySelector('.lightbox-dialog');
      const lightboxStage = carouselNode.querySelector('.lightbox-stage');
      const lightboxImg = carouselNode.querySelector('.lightbox-img');
      const lightboxCaption = carouselNode.querySelector('.lightbox-caption');
      const lightboxClose = carouselNode.querySelector('.lightbox-close');
      const lightboxPrev = carouselNode.querySelector('.lightbox-prev');
      const lightboxNext = carouselNode.querySelector('.lightbox-next');
      const slideImgs = carouselNode.querySelectorAll('.embla__slide__img');

      if (!viewportNode) return;

      const emblaApi = EmblaCarousel(viewportNode, { loop: true });

      // Direction of the last change, so the new image can slide in from the
      // side the user came from. Set by the navigation helpers rather than
      // inferred from indices: with loop:true the index wraps, so 0 -> last
      // would look like "previous" even when the user swiped forward.
      let lightboxDirection = 0;

      const updateLightbox = () => {
        if (!dialog?.open || !lightboxImg) return;

        const selectedIndex = emblaApi.selectedScrollSnap();
        const activeSlideImg = slideImgs[selectedIndex];

        if (!activeSlideImg) return;

        lightboxImg.src = activeSlideImg.src;
        lightboxImg.alt = activeSlideImg.alt;
        if (lightboxCaption) {
          lightboxCaption.textContent = activeSlideImg.dataset.caption || '';
        }

        if (lightboxDirection !== 0) {
          lightboxImg.classList.remove('lightbox-img--from-left', 'lightbox-img--from-right');
          void lightboxImg.offsetWidth;
          lightboxImg.classList.add(
            lightboxDirection > 0 ? 'lightbox-img--from-left' : 'lightbox-img--from-right'
          );
        }
      };

      const goTo = (direction, move) => {
        lightboxDirection = direction;
        move();
      };

      slideImgs.forEach((img, index) => {
        img.addEventListener('click', () => {
          if (!dialog) return;
          if (emblaApi.selectedScrollSnap() !== index) emblaApi.scrollTo(index);
          lightboxDirection = 0;
          dialog.showModal();
          document.body.style.overflow = 'hidden';
          updateLightbox();
        });
      });

      // Keeps the modal in sync when the carousel moves via dots/keys while open.
      emblaApi.on('select', updateLightbox);

      // The modal has no index of its own: its arrows drive Embla directly.
      lightboxPrev?.addEventListener('click', (e) => {
        e.stopPropagation();
        goTo(-1, () => emblaApi.scrollPrev());
      });

      lightboxNext?.addEventListener('click', (e) => {
        e.stopPropagation();
        goTo(1, () => emblaApi.scrollNext());
      });

      // Swipe to move between images while the modal is open.
      let touchStartX = 0;
      let touchStartY = 0;

      lightboxStage?.addEventListener('touchstart', (e) => {
        const touch = e.changedTouches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
      }, { passive: true });

      lightboxStage?.addEventListener('touchend', (e) => {
        if (!dialog?.open) return;
        const touch = e.changedTouches[0];
        const deltaX = touch.clientX - touchStartX;
        const deltaY = touch.clientY - touchStartY;
        if (Math.abs(deltaX) < 40 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
        if (deltaX < 0) goTo(1, () => emblaApi.scrollNext());
        else goTo(-1, () => emblaApi.scrollPrev());
      }, { passive: true });

      const closeLightbox = () => {
        dialog?.close();
        document.body.style.overflow = '';
      };

      lightboxClose?.addEventListener('click', closeLightbox);

      // Tap anywhere on the backdrop (but not the image, caption or a button)
      // to dismiss.
      dialog?.addEventListener('click', (e) => {
        const target = e.target;
        const isInteractive =
          target instanceof Element &&
          target.closest('.lightbox-img, .lightbox-caption, .lightbox-nav, .lightbox-close');
        if (!isInteractive) closeLightbox();
      });

      dialog?.addEventListener('close', () => {
        document.body.style.overflow = '';
      });

      // Keyboard navigation while the modal is open.
      window.addEventListener('keydown', (e) => {
        if (!dialog?.open) return;
        if (e.key === 'ArrowLeft') goTo(-1, () => emblaApi.scrollPrev());
        if (e.key === 'ArrowRight') goTo(1, () => emblaApi.scrollNext());
      });

      if (prevBtnNode) prevBtnNode.addEventListener('click', () => emblaApi.scrollPrev());
      if (nextBtnNode) nextBtnNode.addEventListener('click', () => emblaApi.scrollNext());

      if (dotsNode) {
        const slideCount = emblaApi.scrollSnapList().length;
        dotsNode.innerHTML = '';

        const dotNodes = [];
        for (let i = 0; i < slideCount; i++) {
          const dot = document.createElement('button');
          dot.className = 'embla__dot';
          dot.type = 'button';
          dot.ariaLabel = `Go to slide ${i + 1}`;
          dot.addEventListener('click', () => emblaApi.scrollTo(i));
          dotsNode.appendChild(dot);
          dotNodes.push(dot);
        }

        const updateDots = () => {
          const selectedIndex = emblaApi.selectedScrollSnap();
          dotNodes.forEach((dot, index) => {
            if (index === selectedIndex) {
              dot.classList.add('embla__dot--selected');
            } else {
              dot.classList.remove('embla__dot--selected');
            }
          });
        };

        emblaApi.on('select', updateDots);
        emblaApi.on('init', updateDots);
        updateDots();
      }
    });
  }

  initEmbla();
  document.addEventListener('astro:page-load', initEmbla);
</script>
