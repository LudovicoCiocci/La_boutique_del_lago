---
// src/components/NewsletterPopup.astro
//
// Get these values from Mailchimp:
// Audience > Signup forms > Embedded forms > copy the <form action="..."> URL
// Example: https://yourname.us21.list-manage.com/subscribe/post?u=XXXX&id=YYYY&f_id=ZZZZ
interface Props {
  actionUrl: string; // the full Mailchimp form action URL
  honeypotName: string; // the hidden "b_XXXX_YYYY" field name from the embed code
  privacyUrl?: string;
  delayMs?: number; // delay before the popup shows
  snoozeDays?: number; // how long to stay hidden after close/subscribe
  title?: string;
  text?: string;
}

const {
  actionUrl,
  honeypotName,
  privacyUrl = "/privacy",
  delayMs = 8000,
  snoozeDays = 14,
  title = "Resta in contatto",
  text = "Iscriviti alla newsletter per novità, offerte e aggiornamenti. Niente spam, puoi disiscriverti quando vuoi.",
} = Astro.props;
---

<dialog
  id="nl-popup"
  aria-labelledby="nl-title"
  class="m-auto w-[min(92vw,28rem)] rounded-2xl border-0 bg-white p-0 text-neutral-900 shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-sm"
  data-delay={delayMs}
  data-snooze={snoozeDays}
>
  <div class="relative p-6 sm:p-8">
    <button
      type="button"
      id="nl-close"
      aria-label="Chiudi"
      class="absolute right-3 top-3 z-10 grid size-9 place-items-center rounded-full text-neutral-500 transition hover:bg-neutral-100 hover:text-neutral-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <h2 id="nl-title" class="pr-8 text-2xl font-semibold tracking-tight">{title}</h2>
    <p class="mt-2 text-sm leading-relaxed text-neutral-600">{text}</p>

    <form
      id="nl-form"
      action={actionUrl}
      method="post"
      target="_blank"
      class="mt-6 space-y-4"
      novalidate
    >
      <div>
        <label for="nl-email" class="mb-1 block text-sm font-medium">Email</label>
        <input
          id="nl-email"
          name="EMAIL"
          type="email"
          required
          autocomplete="email"
          placeholder="tu@esempio.com"
          class="w-full rounded-lg border border-neutral-300 px-3 py-2.5 text-base outline-none transition focus:border-neutral-900 focus:ring-2 focus:ring-neutral-900/20"
        />
      </div>

      <label class="flex items-start gap-2 text-xs text-neutral-600">
        <input id="nl-consent" type="checkbox" required class="mt-0.5 size-4 shrink-0 accent-neutral-900" />
        <span>
          Accetto di ricevere email e dichiaro di aver letto la
          <a href={privacyUrl} class="underline underline-offset-2 hover:text-neutral-900" target="_blank" rel="noopener"> Privacy Policy</a>.
        </span>
      </label>

      <!-- Mailchimp bot honeypot: must stay empty, hidden from humans -->
      <div aria-hidden="true" style="position:absolute;left:-5000px;">
        <input type="text" name={honeypotName} tabindex="-1" value="" autocomplete="off" />
      </div>

      <button
        type="submit"
        id="nl-submit"
        class="w-full rounded-lg bg-heading px-4 py-3 text-sm font-semibold text-white transition hover:bg-neutral-700 disabled:cursor-not-allowed disabled:opacity-60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
      >
        Iscriviti
      </button>

      <p id="nl-msg" role="status" aria-live="polite" class="min-h-5 text-sm"></p>
    </form>
  </div>
</dialog>

<script>
  import { bindNewsletterSignup } from "../../scripts/newsletterSignup";

  const KEY = "nl-popup-hidden-until";
  const dialog = document.getElementById("nl-popup") as HTMLDialogElement | null;

  if (dialog) {
    const form = document.getElementById("nl-form") as HTMLFormElement | null;
    const email = document.getElementById("nl-email") as HTMLInputElement | null;
    const consent = document.getElementById("nl-consent") as HTMLInputElement | null;
    const submit = document.getElementById("nl-submit") as HTMLButtonElement | null;
    const msg = document.getElementById("nl-msg") as HTMLElement | null;

    const delay = Number(dialog.dataset.delay) || 8000;
    const snoozeDays = Number(dialog.dataset.snooze) || 14;

    const isSnoozed = () => {
      try {
        return Date.now() < Number(localStorage.getItem(KEY) || 0);
      } catch {
        return false;
      }
    };
    const snooze = () => {
      try {
        localStorage.setItem(KEY, String(Date.now() + snoozeDays * 864e5));
      } catch {}
    };

    const close = () => {
      snooze();
      dialog.close();
    };

    // TESTING ONLY: remove this line before going live. The delay + snooze
    // block at the bottom of this script then takes over.
    dialog.showModal();

    dialog.addEventListener("cancel", snooze); // ESC key
    // Handles both the backdrop and the close button. Binding the close button
    // here rather than on the button itself keeps it working even if a child
    // element swallows the click on its way up.
    dialog.addEventListener("click", (e) => {
      const target = e.target instanceof Element ? e.target : null;
      if (e.target === dialog || target?.closest("#nl-close")) close();
    });

    bindNewsletterSignup({
      form,
      email,
      consent,
      submit,
      message: msg,
      messageBaseClass: "min-h-5 text-sm",
      successText:
        "Ci siamo quasi! Controlla la tua casella di posta (anche lo spam) e conferma l'iscrizione per ricevere il codice sconto.",
      onSuccess: () => {
        snooze();
        setTimeout(() => dialog.open && dialog.close(), 3500);
      },
    });

    // Open once after the delay, only if not snoozed
    if (!isSnoozed()) {
      setTimeout(() => {
        if (!dialog.open && !isSnoozed()) dialog.showModal();
      }, delay);
    }
  }
</script>
