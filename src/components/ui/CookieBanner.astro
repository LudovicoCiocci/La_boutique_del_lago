---

<div 
  id="cookie-banner"
  class="
  fixed bottom-4 left-4 right-4 z-50
  sm:left-auto sm:w-full sm:max-w-sm
  bg-white border border-terracotta/60 rounded-lg
  px-6 py-6
  flex flex-col gap-4
  transition-transform duration-500 ease-out
  "
>
  <div class="flex flex-col gap-2">
    <p class="font-heading text-heading text-lg">Questo sito usa i cookie</p>
    <p class="font-body text-black text-lg leading-relaxed">
      Utilizziamo Google Analytics per analizzare il traffico del sito in forma anonima. Nessun dato viene venduto, e il tracciamento parte solo con il tuo consenso.
      <a href="/privacy" class="text-heading hover:text-teal-800 underline transition-colors duration-200">
        Leggi la privacy policy
      </a>
    </p>
  </div>

  <div id="cookie-preferences-panel" class="hidden flex flex-col gap-3 pt-4 border-t border-beije/20 text-xs text-beije">
    <p class="font-semibold text-beije mb-1">Gestisci le preferenze</p>

    <div class="flex items-center justify-between bg-lake/50 p-2 rounded border border-beije/10">
      <div>
        <p class="font-bold text-text-color">Cookie necessari</p>
        <p class="text-[11px] text-text-color/70">Indispensabili per il funzionamento del sito e per ricordare le tue preferenze.</p>
      </div>
      <span class="text-text-color/60 font-mono text-[10px] uppercase tracking-wider">Sempre attivi</span>
    </div>

    <div class="flex items-center justify-between bg-lake/50 p-2 rounded border border-beije/10">
      <div>
        <label for="cookie-pref-analytics" class="font-bold text-text-color block cursor-pointer">
          Cookie analitici
        </label>
        <p class="text-[11px] text-text-color/70">Ci aiutano a capire come i visitatori interagiscono con il sito.</p>
      </div>
      <input 
        type="checkbox" 
        id="cookie-pref-analytics" 
        class="accent-terracotta w-4 h-4 cursor-pointer"
      />
    </div>

    <button
      id="cookie-save-prefs"
      class="w-full mt-2 py-2 rounded-lg font-body text-lg bg-terracotta/10 text-text-color border border-terracotta/30 hover:bg-terracotta/20 transition-all duration-200"
    >
      Salva selezione
    </button>
  </div>

  <div class="flex flex-row gap-2">
    <button
      id="cookie-decline"
      class="cursor-pointer flex-1 px-3 py-2 rounded-lg font-body text-base border border-heading text-black hover:bg-teal-800 hover:text-white transition-all duration-200"
    >
      Rifiuta
    </button>
    <button
      id="cookie-customize"
      class="cursor-pointer flex-1 px-3 py-2 rounded-lg font-body text-base border border-heading text-black hover:bg-teal-800 hover:text-white transition-all duration-200"
    >
      Personalizza
    </button>
    <button
      id="cookie-accept"
      class="flex-1 px-3 py-2 rounded-lg font-body text-base bg-heading text-black hover:bg-teal-800 hover:text-white duration-200"
    >
      Accetta tutti
    </button>
  </div>
</div>

<script>
const GA_MEASUREMENT_ID = 'G-8QXVH7591T';

// Analytics is only meaningful on the live domain. Without this guard, accepting
// the banner on localhost or a preview URL would send test hits to the client's
// GA property. Add any staging hostname here only if it should report.
const GA_HOSTS = ['laboutiquedellago.com', 'www.laboutiquedellago.com'];
const GA_ALLOWED = GA_HOSTS.includes(window.location.hostname);

// Re-prompt after 6 months: consent should not be treated as permanent.
const CONSENT_MAX_AGE_MS = 180 * 24 * 60 * 60 * 1000;

declare global {
  interface Window {
    dataLayer: any[];
    reopenCookieBanner: () => void;
  }
}

window.dataLayer = window.dataLayer || [];
function gtag(..._args: any[]) {
  window.dataLayer.push(arguments as unknown as any);
}

const banner = document.getElementById('cookie-banner');
const acceptBtn = document.getElementById('cookie-accept');
const declineBtn = document.getElementById('cookie-decline');
const customizeBtn = document.getElementById('cookie-customize');
const savePrefsBtn = document.getElementById('cookie-save-prefs');
const prefsPanel = document.getElementById('cookie-preferences-panel');

const analyticsCheckbox = document.getElementById('cookie-pref-analytics') as HTMLInputElement | null;

function readConsent() {
  const raw = localStorage.getItem('cookie-consent');
  if (!raw) return null;

  // Pre-expiry format was a bare 'accepted' / 'declined' string.
  if (!raw.startsWith('{')) return { value: raw, at: 0 };

  try {
    const parsed = JSON.parse(raw);
    if (parsed?.value !== 'accepted' && parsed?.value !== 'declined') return null;
    return parsed;
  } catch {
    return null;
  }
}

const existingConsent = readConsent();

// An expired or unrecognised record is treated as "no decision yet".
const consentIsFresh = existingConsent !== null
  && Date.now() - (existingConsent.at || 0) < CONSENT_MAX_AGE_MS;
const consentValue = consentIsFresh ? existingConsent.value : null;

if (existingConsent && !consentIsFresh) {
  localStorage.removeItem('cookie-consent');
}

gtag('consent', 'default', {
  'analytics_storage': consentValue === 'accepted' ? 'granted' : 'denied',
  'ad_storage': 'denied',
  'ad_user_data': 'denied',
  'ad_personalization': 'denied'
});

function showBanner() {
  setTimeout(() => { banner?.classList.add('is-visible'); }, 100);
}

function hideBanner() {
  banner?.classList.remove('is-visible');
}

// GA cookies outlive a consent change, so a decline after an accept would leave
// them in place until their own (multi-year) expiry. Expire them on every path
// that revokes consent, across the current host and its parents.
function clearAnalyticsCookies() {
  const suffixes = ['', `_${GA_MEASUREMENT_ID.slice(2)}`];
  const names = [
    ...suffixes.map((s) => `_ga${s}`),
    '_gid',
    '_gat',
    '_gat_thr',
  ];

  const hosts = window.location.hostname.split('.');
  const domains = [''];
  for (let i = 0; i < hosts.length - 1; i++) {
    domains.push(hosts.slice(i).join('.'));
  }

  for (const name of names) {
    for (const domain of domains) {
      document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${domain ? `; domain=${domain}` : ''}`;
    }
  }
}

function revokeAnalytics() {
  gtag('consent', 'update', { 'analytics_storage': 'denied' });
  clearAnalyticsCookies();
}

function loadAnalytics() {
  if (!GA_ALLOWED) return;
  if (!document.getElementById('google-analytics-tag')) {
    const script = document.createElement('script');
    script.id = 'google-analytics-tag';
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
    document.head.appendChild(script);

    gtag('js', new Date());
    gtag('config', GA_MEASUREMENT_ID);
  }
  gtag('consent', 'update', { 'analytics_storage': 'granted' });
}

function setConsent(value: 'accepted' | 'declined') {
  localStorage.setItem('cookie-consent', JSON.stringify({
    value,
    at: Date.now(),
  }));
  hideBanner();
  if (value === 'accepted') {
    loadAnalytics();
  } else {
    revokeAnalytics();
  }
}

if (!consentValue) {
  showBanner();
} else if (consentValue === 'accepted') {
  loadAnalytics();
}

acceptBtn?.addEventListener('click', () => setConsent('accepted'));
declineBtn?.addEventListener('click', () => setConsent('declined'));

customizeBtn?.addEventListener('click', () => {
  prefsPanel?.classList.toggle('hidden');
  if (analyticsCheckbox) {
    analyticsCheckbox.checked = consentValue === 'accepted';
  }
});

savePrefsBtn?.addEventListener('click', () => {
  if (analyticsCheckbox?.checked) {
    setConsent('accepted');
  } else {
    setConsent('declined');
  }
});

window.reopenCookieBanner = () => {
  // Clearing the stored choice without revoking would re-prompt the visitor
  // while analytics carried on in the background, so revoke first.
  revokeAnalytics();
  localStorage.removeItem('cookie-consent');
  prefsPanel?.classList.add('hidden');
  if (analyticsCheckbox) analyticsCheckbox.checked = false;
  showBanner();
};
</script>
