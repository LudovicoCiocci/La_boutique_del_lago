---
import ImageCarousel from '../components/ui/ImageCarousel.astro';
import tool_1 from '../assets/artisan_tools/tool_1.jpeg';
import tool_2 from '../assets/artisan_tools/tool_2.jpeg';
import tool_3 from '../assets/artisan_tools/tool_3.jpeg';

const galleryImages = [
  {
    src: tool_1,
    alt: 'utensile artigianale in legno',
    caption: 'Utensili lavorati a mano'
  },
  {
    src: tool_2,
    alt: 'utensile artigianale tradizionale',
    caption: 'Tradizione e artigianato'
  },
  {
    src: tool_3,
    alt: 'utensile artigianale dettaglio',
    caption: 'Qualità artigianale'
  }
];
---
<section id="utensili" class="py-10 border-b border-teal-600/40 bg-white">
  <div class="title text-center mb-8 px-4"> 
    <h2 class="text-3xl font-heading text-heading">I Nostri Utensili Artigianali</h2>
  </div> 
  <div class="flex flex-col md:flex-row md:max-w-7xl
    md:mx-auto md:px-4 gap-8 lg:gap-12 
    items-center justify-center
    px-4">
    <div class="sm:order-2 w-full md:w-1/2 min-w-0">
      <ImageCarousel images={galleryImages} />
    </div>
    <div class="sm:order-1 reveal-from-left w-full md:w-1/2 max-w-xl px-4 md:px-0 pb-15">

      <h3 class="text-2xl italic font-heading text-heading mb-4">L'arte del legno, tra mani esperte</h3>
      <p class="leading-7 text-2xl font-body text-text-color text-shadow-lg">
        Ogni utensile è scolpito e rifinito a mano, secondo una tradizione che unisce funzionalità e bellezza.
        <br><br>
        <span class="font-bold italic text-heading"> Utensili in legno</span> lavorati con cura, pensati per durare nel tempo e portare un tocco autentico nella tua cucina.
        <br><br>
        La sapienza artigianale si respira in ogni dettaglio, dove la pazienza incontra la maestria.
      </p>
    </div>
  </div>
</section>
