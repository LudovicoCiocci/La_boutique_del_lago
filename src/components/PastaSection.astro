
---
import ImageCarousel from '../components/ui/ImageCarousel.astro';


import pizzoccheri from '../assets/pasta/pasta_1.jpeg';
import pasta_2 from '../assets/pasta/pasta_2a.jpeg';
// import pasta_3 from '../assets/pasta/pasta_3.jpeg';
// import pasta_4 from '../assets/pasta/pasta_4.jpeg';
// import pasta_5 from '../assets/pasta/pasta_5.jpeg';

const galleryImages = [
  {
    src: pizzoccheri,
    alt: 'foto dei pizzoccheri',
    caption: 'foto dei pizzoccheri artigianali'
  },
  {
    src: pasta_2,
    alt: 'Pasta artigianale fresca',
    caption: 'Pasta fatta in casa'
  },
  // {
  //   src: pasta_3,
  //   alt: 'Specialità della casa',
  //   caption: 'Piatti tradizionali'
  // },
  // {
  //   src:pasta_4,
  //   alt:'Pasta artigianale',
  //   caption: 'Pasta artigianale',
  // },
  // {
  //   src:pasta_5,
  //   alt:'Pasta artigianale',
  //   caption:'Pasta artigianale',
  // }
];
---

<section id="pasta" class="py-10 border-b border-teal-600/40 bg-white">
  <div class="title text-center mb-8 px-4"> 
    <h2 class="text-3xl font-heading text-heading">La Nostra Pasta Artigianale</h2>
  </div> 

  <div class="flex flex-col md:flex-row md:max-w-7xl
    md:mx-auto md:px-4 gap-8 lg:gap-12 
    items-center justify-center
    px-4">

    <div class="w-full md:w-1/2 min-w-0 sm:order-2">
      <ImageCarousel images={galleryImages} />
    </div>

    <!-- Text column -->
    <div class="reveal-from-left w-full md:w-1/2 max-w-xl px-4 md:px-0 pb-15 sm:order-1">
      <h3 class="text-2xl font-heading italic text-heading mb-4">Grano, acqua e la pazienza di un tempo</h3>
      <p class="leading-7 text-2xl font-body text-text-color text-shadow-lg">
        Nella nostra boutique trovate una selezione di pasta fresca lavorata secondo le ricette 
        che appartengono a questa terra, tra il lago e le montagne che lo custodiscono.
        <br><br>
        Non potevano mancare i <span class="font-bold italic text-heading">pizzoccheri</span>, 
        simbolo delle valli che si affacciano sul Lario: grano saraceno, pazienza e tradizione 
        racchiusi in ogni formato.
        <br><br>
        Accanto, altre paste artigianali pensate per portare in tavola,anche lontano da qui,
        il sapore autentico del territorio.
      </p>
    </div>
  </div>
</section>
