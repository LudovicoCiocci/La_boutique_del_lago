---
// src/components/NewsletterSection.astro
//
// Inline newsletter signup, shown between the map and the footer.
// Uses the same Mailchimp audience as the newsletter popup
// (configuration lives in src/config/newsletter.ts).
import { NEWSLETTER } from "../config/newsletter";

interface Props {
  title?: string;
  text?: string;
}

const {
  title = "Resta in contatto",
  text = "Iscriviti alla newsletter per novità, offerte e appuntamenti in boutique. Niente spam, puoi disiscriverti quando vuoi.",
} = Astro.props;

const { actionUrl, honeypotName, privacyUrl } = NEWSLETTER;
---

<section id="newsletter" class="bg-white border-t border-teal-600/40 px-4 py-10">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="text-3xl text-heading font-heading">{title}</h2>
    <p class="mt-2 text-lg italic text-text-color font-body">{text}</p>

    <form id="ns-form" action={actionUrl} method="post" target="_blank" class="mx-auto mt-6 max-w-xl text-left" novalidate>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start">
        <div class="flex-1">
          <label for="ns-email" class="sr-only">Email</label>
          <input
            id="ns-email"
            name="EMAIL"
            type="email"
            required
            autocomplete="email"
            placeholder="La tua email"
            class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-3 text-base text-neutral-900 outline-none transition focus:border-terracotta focus:ring-2 focus:ring-terracotta/30"
          />
        </div>
        <button
          type="submit"
          id="ns-submit"
          class="rounded-lg bg-terracotta px-6 py-3 text-sm font-semibold text-white transition hover:bg-terracotta/80 disabled:cursor-not-allowed disabled:opacity-60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terracotta"
        >
          Iscriviti
        </button>
      </div>

      <label class="mt-3 flex items-start gap-2 text-xs text-text-color">
        <input id="ns-consent" type="checkbox" required class="mt-0.5 size-4 shrink-0 accent-terracotta" />
        <span>
          Accetto di ricevere email e dichiaro di aver letto la
          <a href={privacyUrl} class="underline underline-offset-2 hover:text-terracotta" target="_blank" rel="noopener"> Privacy Policy</a>.
        </span>
      </label>

      <!-- Mailchimp bot honeypot: must stay empty, hidden from humans -->
      <div aria-hidden="true" style="position:absolute;left:-5000px;">
        <input type="text" name={honeypotName} tabindex="-1" value="" autocomplete="off" />
      </div>

      <p id="ns-msg" role="status" aria-live="polite" class="mt-3 min-h-5 text-sm"></p>
    </form>
  </div>
</section>
<script>
  import { bindNewsletterSignup } from "../scripts/newsletterSignup";

  bindNewsletterSignup({
    form: document.getElementById("ns-form") as HTMLFormElement | null,
    email: document.getElementById("ns-email") as HTMLInputElement | null,
    consent: document.getElementById("ns-consent") as HTMLInputElement | null,
    submit: document.getElementById("ns-submit") as HTMLButtonElement | null,
    message: document.getElementById("ns-msg") as HTMLElement | null,
    messageBaseClass: "mt-3 min-h-5 text-sm",
    successText:
      "Ci siamo quasi! Controlla la tua casella di posta (anche lo spam) per confermare l'iscrizione.",
  });
</script>
